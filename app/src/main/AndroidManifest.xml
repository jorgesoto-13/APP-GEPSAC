<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Avisos de pedidos (Android 13+ lo pide en pantalla) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- «Usar mi ubicación» para rellenar la dirección de entrega -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Instalar la actualización descargada dentro de la app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".GepsacApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_logo"
        android:label="GEPSAC"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gepsac">
        <activity android:name=".view.auth.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".view.cliente.ClienteActivity" android:exported="false" />
        <activity android:name=".view.admin.AdminActivity" android:exported="false" />
        <activity android:name=".view.seguimiento.SeguimientoActivity" android:exported="false" />
        <activity android:name=".view.mapa.MapaActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>
    </application>
</manifest>
