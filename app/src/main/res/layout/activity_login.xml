<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <!-- Cabecera de marca -->
        <LinearLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_hero" android:gravity="center_horizontal" android:orientation="vertical"
            android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="56dp" android:paddingBottom="40dp">
            <ImageView android:id="@+id/imgLogo" android:layout_width="88dp" android:layout_height="88dp"
                android:background="@drawable/bg_logo_circle" android:padding="22dp" android:src="@drawable/ic_cup"
                android:contentDescription="Logo de GEPSAC" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="GEPSAC" android:textColor="@color/white"
                android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Caffe · Kaphiy" android:textColor="@color/cream_deep" android:textSize="14sp" />
        </LinearLayout>

        <!-- Formulario -->
        <LinearLayout android:id="@+id/form" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="28dp" android:paddingEnd="28dp"
            android:paddingTop="24dp" android:paddingBottom="32dp">

            <TextView android:id="@+id/tvBienvenida" style="@style/Encabezado" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="22sp" />
            <TextView android:id="@+id/tvSubtitulo" style="@style/Etiqueta" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilNombre" style="@style/Campo" android:hint="Nombre completo">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNombre"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName|textCapWords" android:maxLength="50" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilTel" style="@style/Campo" android:hint="Teléfono (9 dígitos)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTel"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:maxLength="11" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilEmail" style="@style/Campo" android:hint="Correo electrónico">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:maxLength="60" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilPass" style="@style/Campo" android:hint="Contraseña (mínimo 6)" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPass"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLength="30" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilPass2" style="@style/Campo" android:hint="Confirmar contraseña" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPass2"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLength="30" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:id="@+id/tvOlvide" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="4dp" android:minHeight="44dp" android:gravity="center_vertical"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground" android:text="¿Olvidaste tu contraseña?"
                android:textColor="@color/green" android:textSize="13sp" android:textStyle="bold" />

            <TextView android:id="@+id/tvError" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="@color/danger" android:textStyle="bold" android:textSize="13sp" android:visibility="gone" />
            <Button android:id="@+id/btnAccion" android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="20dp" android:text="Ingresar" />
            <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone" />
            <TextView android:id="@+id/tvCambiar" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:minHeight="48dp"
                android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:textColor="@color/green" android:textStyle="bold" />

            <!-- Versión de la app que se está usando -->
            <TextView android:id="@+id/tvVersion" style="@style/Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="24dp" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
