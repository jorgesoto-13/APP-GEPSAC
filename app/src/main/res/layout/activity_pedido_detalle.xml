<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/tvVolver" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="6dp" android:text="← Volver" android:clickable="true" android:focusable="true"
            android:textColor="@color/green" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvNumero" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvEstado" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_badge" android:paddingHorizontal="12dp" android:paddingVertical="5dp"
                android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/tvAviso" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:background="@drawable/bg_aviso" android:padding="12dp"
            android:textColor="#6B4A00" android:textSize="13sp" android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp"
            app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:id="@+id/tvCliente" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textStyle="bold" />
                <TextView android:id="@+id/tvContacto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/ink" android:textSize="13sp" />
                <TextView android:id="@+id/tvDireccion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/ink" android:textSize="13sp" />
                <TextView android:id="@+id/tvEntrega" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/ink" android:textSize="13sp" />
                <TextView android:id="@+id/tvPago" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/ink" android:textSize="13sp" android:visibility="gone" />
                <TextView android:id="@+id/tvObs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="Productos" android:textColor="@color/brown" android:textStyle="bold" />
        <TextView android:id="@+id/tvItems" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" android:textColor="@color/ink" />
        <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/brown" android:textSize="18sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="Seguimiento del pedido" android:textColor="@color/brown" android:textStyle="bold" />
        <LinearLayout android:id="@+id/llTimeline" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="vertical" />

        <Button android:id="@+id/btnPagar" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="Pagar pedido" android:visibility="gone" />
        <Button android:id="@+id/btnAvanzar" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" />
        <Button android:id="@+id/btnRetroceder" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnEliminar" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp"
            android:text="Eliminar pedido" android:textColor="#B33A2E" />
    </LinearLayout>
</ScrollView>
