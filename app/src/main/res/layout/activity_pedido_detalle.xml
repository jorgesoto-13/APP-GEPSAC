<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/tvVolver" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="16dp"
            android:background="@drawable/bg_pildora" android:text="Volver" android:clickable="true" android:focusable="true"
            android:drawableStart="@drawable/ic_back" android:drawablePadding="8dp"
            android:textColor="@color/green" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvNumero" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/brown_dark" android:textSize="24sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/tvEstado" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_badge" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="6dp" android:paddingBottom="6dp"
                android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/tvAviso" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:background="@drawable/bg_aviso" android:padding="14dp"
            android:lineSpacingExtra="2dp" android:textColor="@color/aviso_text" android:textSize="14sp" android:visibility="gone" />

        <!-- Datos del cliente -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp"
            app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvCliente" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvContacto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" android:textSize="14sp" />
                <TextView android:id="@+id/tvDireccion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/ink" android:textSize="14sp" />
                <TextView android:id="@+id/tvEntrega" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/ink" android:textSize="14sp" />
                <TextView android:id="@+id/tvPago" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/ink" android:textSize="14sp" android:visibility="gone" />
                <!-- Captura del comprobante de pago (toca para ampliar) -->
                <ImageView android:id="@+id/imgComprobante" android:layout_width="match_parent" android:layout_height="160dp"
                    android:layout_marginTop="8dp" android:background="@color/surface" android:scaleType="fitCenter"
                    android:visibility="gone" android:contentDescription="Comprobante de pago. Toca para ampliar." />
                <TextView android:id="@+id/tvObs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Productos del pedido -->
        <TextView style="@style/Encabezado" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Productos" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp"
            app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvItems" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp" android:textColor="@color/ink" android:textSize="14sp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/line" />
                <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end" android:layout_marginTop="10dp"
                    android:textColor="@color/brown" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Línea de tiempo -->
        <TextView style="@style/Encabezado" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Seguimiento del pedido" />
        <LinearLayout android:id="@+id/llTimeline" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="vertical" />

        <Button android:id="@+id/btnPagar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:text="Pagar pedido" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRepetir" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="20dp" android:text="Volver a pedir" android:visibility="gone"
            app:icon="@drawable/ic_repeat" app:iconTint="@color/on_brown" />
        <Button android:id="@+id/btnAvanzar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" />
        <Button android:id="@+id/btnRetroceder" style="@style/Boton.Contorno"
            android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnEliminar" style="@style/Boton.Contorno"
            android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp"
            android:text="Eliminar pedido" android:textColor="@color/danger" app:strokeColor="@color/danger" />
    </LinearLayout>
</ScrollView>
