<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal">
    <!-- Columna de la línea de tiempo: punto + conector hacia la siguiente etapa -->
    <FrameLayout android:layout_width="24dp" android:layout_height="match_parent">
        <View android:id="@+id/linea" android:layout_width="3dp" android:layout_height="match_parent"
            android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:background="@color/line" />
        <View android:id="@+id/dot" android:layout_width="18dp" android:layout_height="18dp"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="3dp" android:background="@drawable/bg_dot" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="14dp" android:orientation="vertical" android:paddingBottom="18dp">
        <TextView android:id="@+id/tvEtapa" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/tvHora" style="@style/Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
