<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
    <View android:id="@+id/dot" android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_dot" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:id="@+id/tvEtapa" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/ink" android:textStyle="bold" />
        <TextView android:id="@+id/tvHora" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
